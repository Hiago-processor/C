#include <stdio.h>
#include <string.h>
int main(){
int number1, number2, resultado;
char cacteres[20];
    
    printf ("---Bem-Vindo---\nCalculadora\n");
    printf ("Digite o primeiro numero\nR:");
        scanf("%d", &number1);
    
    printf("Selecione o operador: '+' '-' '/' '*'\nR:");
        scanf("%s", cacteres);
    
    printf("Digite o segundo numero\nR:");
        scanf("%d", &number2);    
    
    if(strcmp(cacteres, "+") == 0){
        resultado = number1 + number2;
        printf("%d + %d = %d", number1, number2, resultado);
       }
    else if(strcmp(cacteres, "-") == 0){
        resultado = number1 - number2;
        printf("%d - %d = %d", number1, number2, resultado);
    }
    else if(strcmp(cacteres, "/") == 0){
        resultado = number1 / number2;
        printf("%d / %d = %d", number1, number2, resultado);
    }
    else if(strcmp(cacteres, "*") == 0){
        resultado = number1 * number2;
        printf("%d * %d = %d", number1, number2, resultado);
    }
    else{
        printf("Você digitou errado ou ta zuando ^-^");
    }
    
}
