scanf("%d", &N);
    switch(N){
        case 1:
            printf("Tome seu sorvete de chocolate! Seja bem-vindo sempre!");
        break;
        case 2:
            printf("Tome seu sorvete de morango! Seja bem-vindo sempre!");
        break;
        case 3:
            printf("Tome seu sorvete de flocos! Seja bem-vindo sempre!");
            break;
        default:
            printf("Pelo visto, você não quer sorvete..");
        
    }

    return 0;
}
